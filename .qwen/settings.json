{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "oma-hook-UserPromptSubmit",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'UserPromptSubmit'",
            "timeout": 21
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "name": "oma-hook-PreToolUse",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'PreToolUse' --matcher 'run_shell_command'",
            "timeout": 13
          }
        ],
        "matcher": "run_shell_command"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "name": "oma-hook-PostToolUse",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'PostToolUse' --matcher 'write_file|replace'",
            "timeout": 10
          }
        ],
        "matcher": "write_file|replace"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "oma-hook-Stop",
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR/.qwen/hooks/oma-hook.sh\" --vendor 'qwen' --event 'Stop'",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "ui": {
    "statusLine": {
      "type": "command",
      "command": "'bun' \"$QWEN_PROJECT_DIR/.qwen/hooks/hud.ts\""
    }
  },
  "hooksConfig": {
    "enabled": true
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(oma *)"
    ]
  },
  "mcpServers": {
    "serena": {
      "command": "oma",
      "args": [
        "bridge",
        "--context",
        "oma"
      ],
      "env": {
        "SERENA_LOG_LEVEL": "info"
      }
    },
    "firefox-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "@mozilla/firefox-devtools-mcp@latest",
        "--autoProfile"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--isolated"
      ]
    }
  },
  "model": {
    "generationConfig": {
      "timeout": 300000
    }
  },
  "privacy": {
    "usageStatisticsEnabled": false
  }
}
